 local dockCorner=dock:FindFirstChildOfClass("UICorner")
 if not dockCorner then dockCorner=new("UICorner",{},dock) end

 clampPosition=function(object,x,y)
  local v=viewport()
  local w=object==window and W*scale.Scale or object.Size.X.Offset
  local h=object==window and H*scale.Scale or object.Size.Y.Offset
  local ax,ay=object.AnchorPoint.X,object.AnchorPoint.Y
  object.Position=UDim2.fromOffset(
   math.clamp(x,w*ax+8,math.max(w*ax+8,v.X-w*(1-ax)-8)),
   math.clamp(y,h*ay+8,math.max(h*ay+8,v.Y-h*(1-ay)-8)))
 end

 for _,row in ipairs(pages.Settings:GetChildren()) do
  for _,child in ipairs(row:GetChildren()) do
   if child:IsA("TextLabel") and child.Text=="Background Visibility" then
    row.Visible=false
   end
  end
 end

