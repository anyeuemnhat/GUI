  linkBox.Text=INVITE
 end)

 on(copyButton.Activated,function()
  local copy=
   type(setclipboard)=="function" and setclipboard
   or type(toclipboard)=="function" and toclipboard

  if copy then
   local ok,result=pcall(copy,INVITE)
   if ok and result~=false then
    copyButton.Text="Đã sao chép!"
    task.delay(2,function()
     if copyButton.Parent then
      copyButton.Text="Sao chép link"
     end
    end)
    return
   end
  end

  linkBox:CaptureFocus()
  linkBox.SelectionStart=1
  linkBox.CursorPosition=#INVITE+1
 end)

 local function navOpacity()
  for _,entry in pairs(entries) do
   entry.button.BackgroundTransparency=
    entry.marker.Visible and opacity/100 or 1
  end
 end

 local function panels(value)
  opacity=value
  sidebar.BackgroundTransparency=value/100
  brand.BackgroundTransparency=value/100
  search.BackgroundTransparency=value/100

  for _,page in pairs(pages) do
   for _,row in ipairs(page:GetChildren()) do
    if row:IsA("Frame") or row:IsA("TextButton") then
     row.BackgroundTransparency=value/100
    end
   end
  end

  navOpacity()
 end

 local originalSelect=selectTab
 selectTab=function(name)
  originalSelect(name)
  navOpacity()
 end

