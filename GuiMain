-- Lex Hub: GUI bridge + text settings + Main module.
repeat task.wait() until game:IsLoaded()

local ROOT="https://raw.githubusercontent.com/anyeuemnhat/GUI/"
local GUI_COMMIT="1b50b7c37d243dd1b32152da5b8b37a0de0632eb"

local extension=[===[
if not gui:GetAttribute("LexTextV1") then
 gui:SetAttribute("LexTextV1",true)
 local percent,bold=120,true
 local saved={}
 local skip={[minimize]=true,[close]=true}
 for _,entry in pairs(entries) do skip[entry.icon]=true end

 local function capture(o)
  if saved[o] or skip[o] then return false end
  if not(o:IsA("TextLabel")
   or o:IsA("TextButton") or o:IsA("TextBox")) then
   return false
  end
  local p=o
  while p and p~=gui do
   if p:GetAttribute("LexTextControl") then return false end
   p=p.Parent
  end
  if o.Text=="" then return false end
  local limit
  if o:IsA("TextButton") then
   limit=o:FindFirstChildOfClass("UITextSizeConstraint")
    or new("UITextSizeConstraint",{},o)
   o.TextScaled=true
  end
  saved[o]={
   size=o.TextSize,font=o.Font,box=o.Size,
   pos=o.Position,limit=limit,
  }
  return true
 end

 for _,o in ipairs(gui:GetDescendants()) do capture(o) end

 local function apply()
  for o,b in pairs(saved) do
   if o.Parent then
    local n=math.clamp(
     math.floor(b.size*percent/100+.5),8,48
    )
    o.Font=bold and Enum.Font.GothamBold or b.font
    o.TextSize=n
    if b.limit then
     b.limit.MinTextSize=1
     b.limit.MaxTextSize=n
     b.limit.MinTextSize=math.min(b.size,n)
    end
    if o:IsA("TextLabel") and b.box.Y.Scale==0 then
     o.Size=UDim2.new(
      b.box.X.Scale,b.box.X.Offset,0,
      math.max(b.box.Y.Offset,n+4)
     )
    end
   end
  end

  local b=saved[brandTitle]
  if b then
   brandTitle.Position=UDim2.new(
    b.pos.X.Scale,b.pos.X.Offset,b.pos.Y.Scale,
    math.min(b.pos.Y.Offset,52-brandTitle.Size.Y.Offset)
   )
  end

  local s=saved[subtitle]
  if s then
   subtitle.Position=UDim2.new(
    s.pos.X.Scale,s.pos.X.Offset,s.pos.Y.Scale,
    math.max(
     s.pos.Y.Offset,
     title.Position.Y.Offset+title.Size.Y.Offset+3
    )
   )
  end
 end

 local heading=label(
  pages.Settings,"Chữ",16,
  UDim2.new(),UDim2.new(1,0,0,30),C.accent
 )
 heading.LayoutOrder=-40
 heading:SetAttribute("LexTextControl",true)

 local button=card(pages.Settings,58,true)
 button.Name="LexBoldButton"
 button.LayoutOrder=-39
 button:SetAttribute("LexTextControl",true)
 button.BackgroundTransparency=.6
 button.Text="Chữ đậm: Bật"
 button.Font=Enum.Font.GothamBold
 button.TextSize=17
 button.TextColor3=C.accent

 on(button.Activated,function()
  bold=not bold
  button.Text=bold and "Chữ đậm: Bật" or "Chữ đậm: Tắt"
  apply()
 end)

 local before={}
 for _,o in ipairs(pages.Settings:GetChildren()) do
  before[o]=true
 end

 slider(
  pages.Settings,"Cỡ chữ (%)",80,140,percent,
  function(n) percent=n;apply() end
 )

 for _,o in ipairs(pages.Settings:GetChildren()) do
  if not before[o] and o:IsA("Frame") then
   o.Name="LexTextSizeControl"
   o.LayoutOrder=-38
   o:SetAttribute("LexTextControl",true)
   o.BackgroundTransparency=.6
  end
 end

 on(gui.DescendantAdded,function(o)
  task.defer(function()
   if gui.Parent and capture(o) then apply() end
  end)
 end)

 apply()
 print("LEX_TEXT_SETTINGS_READY")
end

do
 local source=game:HttpGet(
  "https://raw.githubusercontent.com/anyeuemnhat/GUI/refs/heads/main/Functions/Main.lua"
 )
 assert(
  type(source)=="string" and #source>0,
  "Main.lua download is empty"
 )
 source=source:gsub("^\239\187\191","")

 local run,compileError=loadstring(source,"@Functions/Main.lua")
 assert(run,"Main.lua compile error: "..tostring(compileError))

 local module=run()
 assert(
  type(module)=="table" and type(module.Mount)=="function",
  "Main.lua must return a table with Mount(ctx)"
 )

 local controller=module.Mount({
  gui=gui,pages=pages,new=new,card=card,label=label,
  section=section,corner=corner,border=border,
  slider=slider,on=on,C=C,Players=Players,
 })
 assert(controller~=nil,"Main.Mount did not return a controller")
 print("LEX_MAIN_MODULE_READY")
end
]===]

local success,err=pcall(function()
 local source=game:HttpGet(ROOT..GUI_COMMIT.."/GuiMain")
 assert(
  type(source)=="string" and #source>0,
  "GUI download is empty"
 )
 source=source:gsub("^\239\187\191","")
 assert(
  source:find("local music=",1,true),
  "Pinned GUI music payload was not found"
 )

 local patched,count=source:gsub("%]==%]",function()
  return "\n"..extension.."\n]==]"
 end,1)
 assert(count==1,"Pinned GUI music payload has no closing delimiter")

 local run,compileError=loadstring(
  patched,"@LexHub/GuiMainBridge"
 )
 assert(run,"GUI bridge compile error: "..tostring(compileError))
 run()
end)

if not success then
 warn("[Lex Hub] "..tostring(err))
 pcall(function()
  game:GetService("StarterGui"):SetCore("SendNotification",{
   Title="Lex Hub: error",
   Text=tostring(err):sub(1,150),
   Duration=12,
  })
 end)
end
