 local sizeNote=label(dimensions,
  "24–160 px. Tròn/Vuông dùng hai cạnh bằng nhau.",12,
  UDim2.fromOffset(18,96),UDim2.new(1,-36,0,22),C.muted)

 local function applySize(nextShape)
  local value=sizeBox.Text:gsub("×","x")
  local a,b=value:match("^%s*(%d+)%s*[xX]%s*(%d+)%s*$")

  if not a then
   sizeNote.Text="Nhập theo mẫu 80 x 60 rồi bấm Áp dụng."
   return
  end

  local w=math.clamp(tonumber(a),24,160)
  local h=math.clamp(tonumber(b),24,160)
  shape=nextShape or shape
  if shape~="Bo góc" then h=w end

  dock.Size=UDim2.fromOffset(w,h)
  dockCorner.CornerRadius=
   shape=="Tròn" and UDim.new(.5,0)
   or shape=="Vuông" and UDim.new(0,0)
   or UDim.new(0,math.floor(math.min(w,h)*.22))

  sizeBox.Text=w.." x "..h
  sizeNote.Text="Đã áp dụng: "..w.." x "..h.." px / "..shape

  for name,b in pairs(shapeButtons) do
   b.BackgroundColor3=name==shape and C.accent or C.card
   b.TextColor3=name==shape and C.base or C.text
  end

  clampPosition(dock,dock.Position.X.Offset,dock.Position.Y.Offset)
 end

 for i,name in ipairs({"Tròn","Vuông","Bo góc"}) do
  local b=new("TextButton",{
   Name="IconShape"..i,
   Position=UDim2.new((i-1)/3,12,0,46),
   Size=UDim2.new(1/3,-20,0,34),
   BackgroundColor3=C.card,
   BorderSizePixel=0,
   Text=name,
   TextColor3=C.text,
   TextSize=14,
   Font=Enum.Font.Gotham,
   AutoButtonColor=true,
  },shapes)

  corner(b,9)
  shapeButtons[name]=b
  on(b.Activated,function() applySize(name) end)
 end

 on(applyButton.Activated,function() applySize() end)
 on(sizeBox.FocusLost,function(enter)
  if enter then applySize() end
 end)

