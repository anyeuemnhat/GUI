 local function stop(message)
  ticket=ticket+1
  requested=false
  sound:Stop()
  status.Text=message or "Đã dừng. Bấm Phát để nghe lại từ đầu."
 end

 on(selector.Activated,function()
  opened=not opened
  layout()
 end)

 for i,song in ipairs(songs) do
  local option=new("TextButton",{
   Name="LexMusicOption"..i,
   LayoutOrder=i,
   Size=UDim2.new(1,-3,0,38),
   BackgroundColor3=C.card,
   BackgroundTransparency=.2,
   BorderSizePixel=0,
   Text=song.name,
   TextColor3=C.text,
