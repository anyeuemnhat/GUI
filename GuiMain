-- Lex Hub: transparency + Discord
local DISCORD_INVITE = "https://discord.gg/vuWaN9cPN"
local glassAmount = 60

-- Hide the old background-only slider.
for _, row in ipairs(pages.Settings:GetChildren()) do
    for _, child in ipairs(row:GetChildren()) do
        if child:IsA("TextLabel")
            and child.Text == "Background Visibility" then
            row.Visible = false
        end
    end
end

nav.Size = UDim2.new(1, -28, 1, -282)

local discordButton = new("TextButton", {
    Name = "DiscordInvite",
    Position = UDim2.new(0, 14, 1, -85),
    Size = UDim2.new(1, -28, 0, 36),
    BackgroundColor3 = Color3.fromRGB(88, 101, 242),
    BorderSizePixel = 0,
    Text = "Discord  /  Copy invite",
    TextColor3 = C.text,
    TextSize = 13,
    Font = Enum.Font.GothamBold,
    AutoButtonColor = true,
}, sidebar)

corner(discordButton, 10)
border(discordButton, Color3.fromRGB(135, 145, 255))

section(pages.Settings, "Community")

local inviteRow = card(pages.Settings, 94)

label(
    inviteRow, "Discord Invite", 16,
    UDim2.fromOffset(17, 10),
    UDim2.new(1, -34, 0, 24)
)

local inviteBox = new("TextBox", {
    Position = UDim2.fromOffset(17, 43),
    Size = UDim2.new(1, -34, 0, 33),
    BackgroundColor3 = C.base,
    BorderSizePixel = 0,
    Text = DISCORD_INVITE,
    TextColor3 = C.accent,
    TextSize = 14,
    Font = Enum.Font.Gotham,
    ClearTextOnFocus = false,
}, inviteRow)

corner(inviteBox, 8)

on(inviteBox.FocusLost, function()
    inviteBox.Text = DISCORD_INVITE
end)

local backgroundImage = window:FindFirstChild("Background")

local function applyGlass(value)
    glassAmount = math.clamp(value, 0, 90)
    local t = glassAmount / 100

    window.BackgroundTransparency = 1

    if backgroundImage then
        backgroundImage.ImageTransparency = 0.1 + t * 0.65
    end

    shade.BackgroundTransparency = 0.2 + t * 0.75
    sidebar.BackgroundTransparency = 0.1 + t * 0.85
    brand.BackgroundTransparency = 0.12 + t * 0.8
    search.BackgroundTransparency = 0.1 + t * 0.8
    dock.BackgroundTransparency = 0.18 + t * 0.7
    discordButton.BackgroundTransparency = 0.08 + t * 0.6
    inviteBox.BackgroundTransparency = 0.1 + t * 0.8

    for _, page in pairs(pages) do
        for _, row in ipairs(page:GetChildren()) do
            if row:IsA("Frame") or row:IsA("TextButton") then
                row.BackgroundTransparency = 0.12 + t * 0.85
            end
        end
    end

    for _, entry in pairs(entries) do
        entry.button.BackgroundTransparency =
            entry.marker.Visible and (0.08 + t * 0.8) or 1
    end
end

local originalSelectTab = selectTab

selectTab = function(name)
    originalSelectTab(name)

    for _, entry in pairs(entries) do
        entry.button.BackgroundTransparency =
            entry.marker.Visible
            and (0.08 + glassAmount * 0.008)
            or 1
    end
end

on(discordButton.Activated, function()
    local copy =
        type(setclipboard) == "function" and setclipboard
        or type(toclipboard) == "function" and toclipboard

    if copy then
        local ok, result = pcall(copy, DISCORD_INVITE)

        if ok and result ~= false then
            discordButton.Text = "Invite copied!"

            task.delay(2, function()
                if discordButton.Parent then
                    discordButton.Text = "Discord  /  Copy invite"
                end
            end)

            return
        end
    end

    selectTab("Settings")
    inviteBox:CaptureFocus()
    inviteBox.SelectionStart = 1
    inviteBox.CursorPosition = #DISCORD_INVITE + 1
end)

section(pages.Settings, "Transparency")
slider(
    pages.Settings,
    "GUI Transparency",
    0, 90, glassAmount,
    applyGlass
)