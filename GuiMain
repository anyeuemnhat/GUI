  corner(option,7)

  on(option.Activated,function()
   if selected~=i then
    stop("Đã chọn: "..song.name)
    selected=i
    sound.SoundId="rbxassetid://"..song.id
   end
   selector.Text=song.name.."  v"
   opened=false
   layout()
  end)
 end

 local function button(name,title,index)
  local b=new("TextButton",{
   Name=name,
   Position=UDim2.new((index-1)/3,0,0,0),
   Size=UDim2.new(1/3,-7,1,0),
   BackgroundColor3=C.card,
   BackgroundTransparency=.12,
   BorderSizePixel=0,
   Text=title,
   TextColor3=C.text,
   TextSize=14,
   Font=Enum.Font.GothamBold,
  },controls)
  corner(b,9)
  border(b)
  return b
 end

 local play=button("LexMusicPlay","Phát",1)
 local halt=button("LexMusicStop","Dừng",2)
 local loop=button("LexMusicLoop","Lặp: Tắt",3)

 on(play.Activated,function()
  if requested and sound.Playing then return end

  requested=true
  ticket=ticket+1
  local current=ticket

  local ok,err=pcall(function() sound:Play() end)
  if not ok then
   requested=false
   status.Text="Không phát được: "..tostring(err)
   return
  end

  status.Text=sound.IsLoaded
   and ("Đang phát: "..songs[selected].name)
   or "Đang tải nhạc..."

  task.delay(25,function()
   if alive and requested and ticket==current and not sound.IsLoaded then
    stop("Chưa tải được audio. Kiểm tra trạng thái/quyền dùng audio trong game hoặc thử lại.")
   end
  end)
 end)

 on(halt.Activated,function()
  stop()
 end)

 on(loop.Activated,function()
  sound.Looped=not sound.Looped
  loop.Text=sound.Looped and "Lặp: Bật" or "Lặp: Tắt"
  loop.BackgroundColor3=sound.Looped and C.accent or C.card
  loop.TextColor3=sound.Looped and C.base or C.text
 end)

 on(sound.Loaded,function()
  if alive and requested and sound.IsLoaded then
   status.Text="Đang phát: "..songs[selected].name
  end
 end)

 on(sound.Ended,function()
  if alive and not sound.Looped then
   requested=false
   ticket=ticket+1
   status.Text="Đã hết bài. Bấm Phát để nghe lại."
  end
 end)

 layout()
 print("LEX_MUSIC_READY")
end
