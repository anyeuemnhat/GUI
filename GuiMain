repeat task.wait() until game:IsLoaded()

local Players = game:GetService("Players")
local player = Players.LocalPlayer

repeat task.wait() until player

local ROOT =
    "https://raw.githubusercontent.com/anyeuemnhat/GUI/main/"

local ok, err = pcall(function()
    loadstring(game:HttpGet(ROOT .. "GuiMain"))()
end)

if not ok then
    warn("Lex Hub GUI: " .. tostring(err))
    return
end

local parent = player:WaitForChild("PlayerGui")

if type(gethui) == "function" then
    local success, result = pcall(gethui)
    if success and result then
        parent = result
    end
end

local old = parent:FindFirstChild("LexFarmLibrary")
if old then old:Destroy() end

local config = getgenv().LexFarm or {}
config.Enabled = false
config.Mode = config.Mode or "Farm LV"
config.FarmDistance = config.FarmDistance or {}
config.FarmAura = config.FarmAura or {}
config.FarmDistance.Distance = 20
config.FarmAura.Radius = 100

getgenv().LexFarm = config

local gui = Instance.new("ScreenGui")
gui.Name = "LexFarmLibrary"
gui.ResetOnSpawn = false
gui.Parent = parent

local frame = Instance.new("Frame")
frame.Name = "FarmWindow"
frame.Size = UDim2.fromOffset(300, 310)
frame.Position = UDim2.new(.5, -150, .5, -155)
frame.BackgroundColor3 = Color3.fromRGB(18, 25, 37)
frame.Parent = gui

Instance.new("UICorner", frame).CornerRadius =
    UDim.new(0, 14)

local scale = Instance.new("UIScale")
scale.Parent = frame

local camera = workspace.CurrentCamera
if camera then
    local v = camera.ViewportSize
    scale.Scale = math.min(
        1,
        (v.X - 20) / 300,
        (v.Y - 20) / 310
    )
end

local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 8)
layout.HorizontalAlignment =
    Enum.HorizontalAlignment.Center
layout.Parent = frame

local padding = Instance.new("UIPadding")
padding.PaddingTop = UDim.new(0, 12)
padding.Parent = frame

local function makeButton(title, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -24, 0, 43)
    b.BackgroundColor3 =
        Color3.fromRGB(35, 48, 65)
    b.TextColor3 = Color3.new(1, 1, 1)
    b.TextSize = 15
    b.Font = Enum.Font.GothamBold
    b.Text = title
    b.Parent = frame

    Instance.new("UICorner", b).CornerRadius =
        UDim.new(0, 9)

    b.Activated:Connect(function()
        callback(b)
    end)

    return b
end

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -20, 0, 34)
title.BackgroundTransparency = 1
title.Text = "LEX HUB | AUTO FARM"
title.TextColor3 = Color3.fromRGB(132, 190, 226)
title.Font = Enum.Font.GothamBold
title.TextSize = 19
title.Parent = frame

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -20, 0, 28)
status.BackgroundTransparency = 1
status.TextColor3 = Color3.new(1, 1, 1)
status.TextSize = 13
status.Text = "Status: OFF"
status.Parent = frame

local function start(mode)
    config.Mode = mode
    config.Enabled = true
    status.Text = "Selected: " .. mode
end

makeButton("Farm LV", function()
    start("Farm LV")
end)

makeButton("Farm Distance", function()
    start("Farm Distance")
end)

makeButton("Farm Aura", function()
    start("Farm Aura")
end)

makeButton("STOP FARM", function()
    config.Enabled = false
    status.Text = "Status: OFF"
end)

local open = makeButton("CLOSE / OPEN", function()
    frame.Visible = false
end)

local dock = Instance.new("TextButton")
dock.Size = UDim2.fromOffset(85, 38)
dock.Position = UDim2.fromOffset(10, 70)
dock.BackgroundColor3 = Color3.fromRGB(35, 48, 65)
dock.TextColor3 = Color3.new(1, 1, 1)
dock.Text = "FARM"
dock.TextSize = 16
dock.Parent = gui

Instance.new("UICorner", dock).CornerRadius =
    UDim.new(0, 10)

dock.Activated:Connect(function()
    frame.Visible = not frame.Visible
end)

print("LEX FARM LIBRARY READY")