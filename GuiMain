local function new(class, props, owner)
    local object = Instance.new(class)
    for key, value in pairs(props) do
        object[key] = value
    end
    object.Parent = owner
    return object
end

local function corner(object, radius)
    new("UICorner", {
        CornerRadius = UDim.new(0, radius or 12),
    }, object)
end

local function border(object, color)
    new("UIStroke", {
        Color = color or C.edge,
        Thickness = 1,
        Transparency = 0.25,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, object)
end

local function label(owner, text, size, position, dimensions, color)
    return new("TextLabel", {
        BackgroundTransparency = 1,
        Text = text,
        Font = Enum.Font.Gotham,
        TextSize = size,
        TextColor3 = color or C.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Position = position,
        Size = dimensions,
    }, owner)
end

local function animate(object, props)
    TweenService:Create(
        object,
        TweenInfo.new(0.16, Enum.EasingStyle.Quad),
        props
    ):Play()
end

